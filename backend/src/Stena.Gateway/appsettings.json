{
  "ReverseProxy": {
    "Routes": {
      "identity-openapi": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/openapi/identity.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          },
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "identity-api": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/auth/{**rest}"
        }
      },
      "canvas-openapi": {
        "ClusterId": "canvas",
        "Match": {
          "Path": "/openapi/canvas.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          },
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "canvas-walls": {
        "ClusterId": "canvas",
        "Match": {
          "Path": "/walls/{**rest}"
        }
      },
      "canvas-hub": {
        "ClusterId": "canvas",
        "Match": {
          "Path": "/hub/{**rest}"
        }
      },
      "history-openapi": {
        "ClusterId": "history",
        "Match": {
          "Path": "/openapi/history.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          },
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "history-api": {
        "ClusterId": "history",
        "Match": {
          "Path": "/history/{**rest}"
        }
      },
      "render-openapi": {
        "ClusterId": "render",
        "Match": {
          "Path": "/openapi/render.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          },
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "render-api": {
        "ClusterId": "render",
        "Match": {
          "Path": "/render/{**rest}"
        }
      },
      "web": {
        "ClusterId": "web",
        "Order": 1000,
        "Match": {
          "Path": "/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity": {
            "Address": "http://identity:8080"
          }
        }
      },
      "canvas": {
        "Destinations": {
          "canvas": {
            "Address": "http://canvas:8080"
          }
        }
      },
      "history": {
        "Destinations": {
          "history": {
            "Address": "http://history:8080"
          }
        }
      },
      "render": {
        "Destinations": {
          "render": {
            "Address": "http://render:8080"
          }
        }
      },
      "web": {
        "Destinations": {
          "web": {
            "Address": "http://web:80"
          }
        }
      }
    }
  }
}
