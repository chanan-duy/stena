{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-openapi": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/openapi/identity.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          },
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "canvas-openapi": {
        "ClusterId": "canvas",
        "Match": {
          "Path": "/openapi/canvas.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          },
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "history-openapi": {
        "ClusterId": "history",
        "Match": {
          "Path": "/openapi/history.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          },
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      },
      "render-openapi": {
        "ClusterId": "render",
        "Match": {
          "Path": "/openapi/render.json"
        },
        "Transforms": [
          {
            "PathSet": "/openapi/v1.json"
          },
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity": {
            "Address": "http://identity:8080"
          }
        }
      },
      "canvas": {
        "Destinations": {
          "canvas": {
            "Address": "http://canvas:8080"
          }
        }
      },
      "history": {
        "Destinations": {
          "history": {
            "Address": "http://history:8080"
          }
        }
      },
      "render": {
        "Destinations": {
          "render": {
            "Address": "http://render:8080"
          }
        }
      }
    }
  }
}
